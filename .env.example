# Lokal: isi dari `npx supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
# Produksi: Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Rahasia — hanya dipakai di server (reset sandi akun tim oleh manajer). Jangan beri prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Web Push kapster (Tahap 2). Buat kunci: `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.com
# Rahasia bersama antara database (trigger pg_net) dan /api/push. Samakan dengan app_config.push_secret.
PUSH_SECRET=

# URL publik situs (canonical, sitemap, OpenGraph, JSON-LD). Produksi: https://domainanda.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Captcha Cloudflare Turnstile (booking tamu & daftar/masuk pelanggan). Kosong = nonaktif.
# Aktifkan juga di Supabase → Authentication → Attack Protection → Captcha (provider Turnstile, secret yang sama).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email konfirmasi & pengingat H-1 via Resend. Kosong = dilewati.
RESEND_API_KEY=
EMAIL_FROM="D'Pras Studio <booking@domainanda.com>"

# WhatsApp otomatis via penyedia pihak ketiga (POST {to, message}). Kosong = dilewati.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Konsultasi gaya rambut (menu Gaya di aplikasi kapster). Kosong = fitur nonaktif.
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4.1          # analisis foto (structured output)
# OPENAI_IMAGE_MODEL=gpt-image-2       # pratinjau; paling menjaga wajah (gpt-image-1/1.5 mengubah wajah)
# OPENAI_IMAGE_QUALITY=high            # low | medium | high — high paling menjaga wajah (biaya & waktu lebih besar)
# HAIR_CONSULT_DAILY_LIMIT=30          # konsultasi per pengguna per 24 jam
# HAIR_DEBUG_DIR=.debug-gaya           # lokal saja: simpan gambar antara pratinjau untuk diperiksa
